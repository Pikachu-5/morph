<?xml version="1.0" encoding="utf-8"?>

<!--
  Morph — package manifest (architecture sections 9.1 and 13).

  This is the registration half of the shell extension. The other half is
  src/shellext, and the two are joined by exactly one thing: the CLSID below,
  which must match kMorphContextMenuClsid in src/shellext/shellext.h. There is
  no DllRegisterServer and no HKCR writing anywhere in this project -- the class
  is declared here, activated through a surrogate, and disappears completely
  when the package is removed.

  NOT YET A SHIPPING PACKAGE. Identity, publisher and the signing certificate
  are placeholders until section 20.1's naming question is settled and a Store
  reservation exists; the visual assets referenced here are not in the tree yet.
  What this file IS today is the exact shape section 9.1 specifies, kept next to
  the code it registers so the two cannot drift apart, and the starting point
  for the packaging milestone.
-->

<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    IgnorableNamespaces="uap rescap com desktop4 desktop5">

  <Identity
      Name="Morph.Converter"
      Publisher="CN=Morph (placeholder)"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Morph</DisplayName>
    <PublisherDisplayName>Morph</PublisherDisplayName>
    <Description>A native Windows file conversion engine.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Section 20.3: Windows 11 only. 10.0.22000.0 is the 21H2 floor the
         compile settings already enforce with NTDDI_VERSION. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0"
                        MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <!-- No network capability anywhere in the package. Section 1: "Local only,
         no network egress at all", and section 3.1 says the worker has none. A
         converter that cannot reach the internet cannot leak a document. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Morph" Executable="Morph.App.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Morph"
          Description="Convert files without uploading them anywhere."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- The surrogate. Section 9.1: the handler is activated out of process
             rather than loaded into explorer.exe, which means a crash in the
             menu takes down a host process nobody notices instead of the
             user's desktop. Explorer still blocks on activation and on the
             GetState / IEnumExplorerCommand calls, so the 8 ms budget in
             section 17 stands regardless. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Morph Context Menu">
              <com:Class Id="6F3E1D0A-9C4B-4E58-9A2F-0B5E7C1D8A34"
                         Path="morph.shellext.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Type="*": the menu decides for itself whether it has anything to
             offer, by reading the capability table (section 9.2). Registering
             per extension instead would mean a package update every time a
             codec package appeared on the machine. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="MorphConvert"
                             Clsid="6F3E1D0A-9C4B-4E58-9A2F-0B5E7C1D8A34" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
