<?xml version="1.0" encoding="utf-8"?>

<!--
  Morph, the DEVELOPMENT manifest (architecture sections 12 and 13).

  WHY A SECOND MANIFEST EXISTS. Section 13 ships this packaged, and the shell
  extension cannot be loaded by Explorer at all without package identity. This
  file is how the app gets an identity during development, through
  `Add-AppxPackage -Register` over the build output directory, so the packaged
  path is exercised long before the packaging milestone rather than for the first
  time at the end of it. It is NOT the shipping package: AppxManifest.xml next
  door is, and the two must be kept in step by hand for as long as both exist.

  Running packaged is OPTIONAL. The app runs unpackaged too, and did before this
  file existed; identity was tried as a fix for WinUI's theme resources failing
  to load, which it is not (see the note above `struct App` in main.cpp). What
  identity IS needed for is the shell extension, and eventually the Store.

  WHAT IS DELIBERATELY ABSENT is the whole of the shell extension: the
  com:Extension, the surrogate server, and the fileExplorerContextMenus entry.
  Registering those puts a verb in the right-click menu of every file on the
  developer's machine, which is a real change to somebody's desktop and not
  something a build step should make on its own. The shell extension has its own
  moment, and it is the packaging milestone.

  Note for anyone editing the prose above: a double hyphen is not legal inside
  an XML comment, and the deployment error it produces names a column rather
  than the reason.

  To register (Developer Mode must be on):

      Add-AppxPackage -Register out\build\x64-debug\bin\AppxManifest.xml

  To remove:

      Get-AppxPackage Morph.Converter.Dev | Remove-AppxPackage
-->

<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <!-- A DIFFERENT NAME from the shipping package on purpose. Section 10.1
       derives the broker pipe name and the capability table name from the
       install tag, so a development registration sharing an identity with an
       installed build would have the two talking to each other's broker. -->
  <Identity
      Name="Morph.Converter.Dev"
      Publisher="CN=Morph (placeholder)"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Morph (development)</DisplayName>
    <PublisherDisplayName>Morph</PublisherDisplayName>
    <Description>A native Windows file conversion engine.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Section 20.3: Windows 11 only. 10.0.22000.0 is the 21H2 floor the
         compile settings already enforce with NTDDI_VERSION. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0"
                        MaxVersionTested="10.0.22631.0" />

    <!-- A PACKAGED app does not bootstrap the Windows App Runtime; it declares
         it, and the deployment stack puts it in the package graph before the
         process starts. Getting this wrong is not a diagnosable failure: the
         process is created and dies before main, with no window and nothing
         written anywhere. The version must match the SDK line the app was built
         against, which winappsdk.cmake also pins. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8"
                       MinVersion="8000.946.1701.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <!-- No network capability, here or in the shipping manifest. Section 1:
         "Local only, no network egress at all". -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Morph" Executable="Morph.App.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Morph (development)"
          Description="Convert files without uploading them anywhere."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
